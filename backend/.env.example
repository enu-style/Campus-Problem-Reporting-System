# ======================================================
# Injibara Campus Reporting - Backend Environment
# ======================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files to version control.

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/injibara_campus_reporting"

# Server
PORT=5000
NODE_ENV=production

# JWT Authentication (use a strong random secret in production)
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# Email (SMTP) for notifications
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=noreply@injibara.edu.et
MAIL_FROM_NAME="Injibara Campus Reporting"

# File Upload Limits (bytes)
MAX_FILE_SIZE=5242880
MAX_FILE_COUNT=5