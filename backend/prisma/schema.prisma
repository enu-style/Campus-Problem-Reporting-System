generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model Department {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  users       User[]
  complaints  Complaint[]
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("departments")
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       Int      @map("role_id")
  departmentId Int?     @map("department_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role                Role                     @relation(fields: [roleId], references: [id])
  department          Department?              @relation(fields: [departmentId], references: [id])
  complaints          Complaint[]
  assignedComplaints  Complaint[]              @relation("AssignedOfficer")
  statusChanges       ComplaintStatusHistory[]
  comments            ComplaintComment[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]

  @@map("users")
}

model Category {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  complaints  Complaint[]
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("categories")
}

model Location {
  id         Int         @id @default(autoincrement())
  building   String
  floor      String?
  room       String?
  area       String?
  complaints Complaint[]
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("locations")
}

model Complaint {
  id                  Int             @id @default(autoincrement())
  title               String
  description         String
  priority            Priority        @default(MEDIUM)
  status              ComplaintStatus @default(PENDING)
  reportedById        Int             @map("reported_by_id")
  categoryId          Int             @map("category_id")
  locationId          Int?            @map("location_id")
  locationDescription String?         @map("location_description")
  latitude            Float?          @map("latitude")
  longitude           Float?          @map("longitude")
  departmentId        Int?            @map("department_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  reporter      User                     @relation(fields: [reportedById], references: [id])
  category      Category                 @relation(fields: [categoryId], references: [id])
  location      Location?                @relation(fields: [locationId], references: [id])
  department    Department?              @relation(fields: [departmentId], references: [id])
  assignedTo    User?                    @relation("AssignedOfficer", fields: [assignedToId], references: [id])
  statusHistory ComplaintStatusHistory[]
  comments      ComplaintComment[]

  attachments   ComplaintAttachment[]
  notifications Notification[]

  assignedToId Int? @map("assigned_to_id")

  @@index([status])
  @@index([reportedById])
  @@index([departmentId])
  @@index([createdAt])
  @@map("complaints")
}

model ComplaintStatusHistory {
  id          Int              @id @default(autoincrement())
  complaintId Int              @map("complaint_id")
  oldStatus   ComplaintStatus? @map("old_status")
  newStatus   ComplaintStatus  @map("new_status")
  changedById Int              @map("changed_by_id")
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedBy User      @relation(fields: [changedById], references: [id])

  @@map("complaint_status_history")
}

model ComplaintComment {
  id          Int      @id @default(autoincrement())
  complaintId Int      @map("complaint_id")
  userId      Int      @map("user_id")
  comment     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([complaintId])
  @@map("complaint_comments")
}

model ComplaintAttachment {
  id           Int      @id @default(autoincrement())
  complaintId  Int      @map("complaint_id")
  originalName String   @map("original_name")
  storedName   String   @unique @map("stored_name")
  mimeType     String   @map("mime_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_attachments")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  PENDING
  REVIEWED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
  REOPENED
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  complaintId Int?     @map("complaint_id")
  type        String
  message     String
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
